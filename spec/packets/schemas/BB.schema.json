{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "/packets/schemas/BB.schema.json",
  "title": "BB",
  "description": "Server notice shown to the client in a popup.",
  "type": "object",
  "properties": {
    "$header": {
      "type": "string",
      "const": "BB"
    },
    "message": {
      "type": "string",
      "description": "Notice text."
    }
  },
  "required": [
    "$header",
    "message"
  ],
  "additionalProperties": false,
  "x-receiver": "client"
}
